---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { business, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
}
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${business.url}/#business`,
  name: business.name,
  url: business.url,
  telephone: `+1-${business.phone}`,
  description,
  image: `${business.url}/assets/photos/support-hug-1200.webp`,
  logo: `${business.url}/assets/brand/logo.png`,
  sameAs: [business.bbb],
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.locations[0].street,
    addressLocality: business.locations[0].city,
    addressRegion: business.locations[0].region,
    postalCode: business.locations[0].zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: ['West Point, MS', 'Columbus, MS', 'Starkville, MS', 'Aberdeen, MS', 'Clay County, MS'].map((name) => ({ '@type': 'Place', name })),
  employee: { '@type': 'Person', name: business.director, jobTitle: 'Director' },
  department: [
    {
      '@type': 'LocalBusiness',
      name: `${business.name} Adult Day Services`,
      telephone: `+1-${business.phone}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.locations[1].street,
        addressLocality: business.locations[1].city,
        addressRegion: business.locations[1].region,
        addressCountry: 'US',
      },
    },
  ],
};
const pinIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>';
const phoneIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1Z"/></svg>';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d0f2e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${business.url}/assets/photos/support-hug-1200.webp`} />
    <meta name="robots" content="noindex" /> {/* prototype: remove at launch */}
    <link rel="preload" as="image" href="/assets/brand/lockup.webp" />
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a class="brand brand-badge" href="/" aria-label="Heavenly Angels home">
          <img src="/assets/brand/lockup.webp" alt="Heavenly Angels LLC" width="1136" height="600" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
          <span class="sr-only">Menu</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
          <div class="sheet-extra">
            <a class="btn btn-gold" href={business.phoneHref}><Fragment set:html={phoneIcon} />Call {business.phone}</a>
            <a class="btn btn-ghost" href={business.locations[0].maps} target="_blank" rel="noopener"><Fragment set:html={pinIcon} />Get directions</a>
            <p>1333 East Broad Street · West Point, MS<br />Staff on site 24/7</p>
          </div>
        </nav>
        <a class="btn btn-white header-call" href={business.phoneHref}>
          <Fragment set:html={phoneIcon} />
          <span>{business.phone}</span>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Heavenly Angels home">
            <img src="/assets/brand/lockup-on-dark.webp" alt="Heavenly Angels LLC" width="1136" height="600" loading="lazy" />
          </a>
          <p>Supervised living and adult day services for adults with disabilities in West Point, Mississippi.</p>
          <a class="footer-bbb" href={business.bbb} target="_blank" rel="noopener">
            <img src="/assets/brand/bbb-seal.png" alt="Heavenly Angels, LLC BBB Business Review" width="293" height="61" loading="lazy" />
          </a>
        </div>
        {business.locations.map((loc) => (
          <div>
            <h2 class="footer-h">{loc.label}</h2>
            <address>
              {loc.street}<br />{loc.city}, {loc.region} {loc.zip}
            </address>
            <a class="footer-link" href={loc.maps} rel="noopener" target="_blank">Get directions</a>
          </div>
        ))}
        <div>
          <h2 class="footer-h">Talk to us</h2>
          <a class="footer-phone" href={business.phoneHref}>{business.phone}</a>
          <p class="footer-small">Staff on site 24 hours a day, 7 days a week.</p>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} Heavenly Angels LLC · West Point, MS</span>
        <a href="/privacy/">Privacy</a>
      </div>
    </footer>

    <div class="dock" data-dock>
      <a class="btn btn-gold" href={business.phoneHref}><Fragment set:html={phoneIcon} />Call us</a>
      <a class="btn btn-white" href="#visit"><Fragment set:html={pinIcon} />Plan a visit</a>
    </div>

    <style is:global>
      .skip {
        position: absolute; left: 16px; top: -60px; z-index: 100;
        background: var(--gold); color: var(--ink); padding: 12px 18px; border-radius: 10px;
        font-weight: 700; text-decoration: none;
      }
      .skip:focus { top: 16px; }

      .site-header {
        position: fixed; inset: 0 0 auto; z-index: 50;
        padding-block: 10px;
        padding-top: max(10px, env(safe-area-inset-top));
        transition: background-color 0.3s, backdrop-filter 0.3s;
      }
      .site-header.scrolled {
        background: rgba(13, 15, 46, 0.78);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }
      .header-inner { display: flex; align-items: center; gap: 24px; }
      .brand { display: inline-flex; align-items: center; flex: none; text-decoration: none; }
      .brand-badge {
        padding: 7px 16px 7px 10px; border-radius: 18px;
        background: var(--cream);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.45);
        transform-origin: left center;
        transition: transform 0.35s var(--ease-out);
      }
      .brand-badge:hover { transform: rotate(-2deg); }
      .site-header.scrolled .brand-badge { transform: scale(0.86); }
      .brand-badge img { width: auto; height: 54px; }
      .site-nav { margin-left: auto; }
      .site-nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
      .site-nav a:not(.btn) {
        display: block; padding: 10px 14px; border-radius: 999px;
        color: #fff; text-decoration: none; font-weight: 600; font-size: 1rem; white-space: nowrap;
        transition: background-color 0.2s;
      }
      .site-nav a:not(.btn):hover { background: rgba(255, 255, 255, 0.1); }
      .sheet-extra { display: none; }
      .header-call { min-height: 46px; padding: 0 18px; font-size: 1rem; white-space: nowrap; flex: none; }

      .site-footer { background: var(--twilight-deep); padding: 80px 0 48px; color: var(--mist); }
      .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
      .footer-brand img { width: 210px; height: auto; }
      .footer-brand p { margin-top: 18px; max-width: 30ch; }
      .footer-bbb { display: inline-block; background: #fff; padding: 8px 10px; border-radius: 12px; }
      .footer-bbb img { width: 180px; height: auto; }
      .footer-h {
        font: 700 0.875rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase;
        color: #fff; margin-bottom: 14px;
      }
      .site-footer address { font-style: normal; margin-bottom: 10px; }
      .footer-link { color: var(--gold); font-weight: 600; }
      .footer-phone { font: 800 1.25rem/1 var(--font-display); color: #fff; text-decoration: none; }
      .footer-small { margin-top: 10px; font-size: 0.875rem; }
      .footer-base {
        display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
        margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.875rem;
      }

      .dock { display: none; }
      .menu-btn { display: none; }
      body.menu-open { overflow: hidden; }
      body.menu-open .site-header { background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }

      @media (max-width: 1080px) {
        .menu-btn {
          position: relative; z-index: 2;
          display: grid; place-items: center; order: 3;
          width: 50px; height: 50px; border-radius: 16px; border: 0; cursor: pointer;
          background: rgba(255, 255, 255, 0.12); color: #fff;
          -webkit-tap-highlight-color: transparent;
        }
        .menu-lines, .menu-lines::before, .menu-lines::after {
          display: block; width: 20px; height: 2px; border-radius: 2px; background: currentColor;
          transition: transform 0.3s var(--ease-out), opacity 0.2s;
        }
        .menu-lines { position: relative; }
        .menu-lines::before, .menu-lines::after { content: ''; position: absolute; left: 0; }
        .menu-lines::before { top: -6px; }
        .menu-lines::after { top: 6px; }
        [aria-expanded='true'] .menu-lines { background: transparent; }
        [aria-expanded='true'] .menu-lines::before { transform: translateY(6px) rotate(45deg); }
        [aria-expanded='true'] .menu-lines::after { transform: translateY(-6px) rotate(-45deg); }

        /* Full-screen sheet */
        .site-nav {
          position: fixed; inset: 0; z-index: 1; margin: 0;
          display: flex; flex-direction: column; justify-content: center;
          padding: 110px var(--gutter) max(32px, env(safe-area-inset-bottom));
          background:
            radial-gradient(ellipse at 80% 0%, rgba(255, 197, 107, 0.16), transparent 55%),
            linear-gradient(180deg, var(--twilight-deep), var(--dusk));
          opacity: 0; visibility: hidden;
          clip-path: circle(0% at calc(100% - 48px) 40px);
          transition: clip-path 0.55s var(--ease-out), opacity 0.3s, visibility 0.55s;
        }
        .site-nav.open { opacity: 1; visibility: visible; clip-path: circle(150% at calc(100% - 48px) 40px); }
        .site-nav ul { flex-direction: column; gap: 2px; }
        .site-nav a:not(.btn) {
          padding: 12px 4px; border-radius: 0;
          font: 800 clamp(1.6rem, 7.2vw, 2.6rem)/1.05 var(--font-display); text-transform: uppercase;
          opacity: 0; transform: translateY(18px);
          transition: opacity 0.4s, transform 0.5s var(--ease-out);
        }
        .site-nav a:not(.btn):hover { background: none; color: var(--gold); }
        .site-nav.open a:not(.btn) { opacity: 1; transform: none; }
        .site-nav.open li:nth-child(1) a { transition-delay: 0.12s; }
        .site-nav.open li:nth-child(2) a { transition-delay: 0.17s; }
        .site-nav.open li:nth-child(3) a { transition-delay: 0.22s; }
        .site-nav.open li:nth-child(4) a { transition-delay: 0.27s; }
        .sheet-extra { display: grid; gap: 12px; margin-top: 36px; }
        .sheet-extra .btn { width: 100%; }
        .sheet-extra p { margin: 8px 0 0; font-size: 0.875rem; color: var(--mist); }
        .header-call { margin-left: auto; }
        .brand { position: relative; z-index: 2; }
        .footer-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 640px) {
        .brand-badge { padding: 5px 12px 5px 8px; border-radius: 15px; }
        .brand-badge img { height: 44px; }
        .header-call { display: none; }
        .menu-btn { margin-left: auto; }
        .site-footer { padding: 64px 0 calc(110px + env(safe-area-inset-bottom)); }
        .footer-grid { grid-template-columns: 1fr; gap: 32px; }
        .footer-brand img { width: 190px; }

        /* Floating action dock */
        .dock {
          position: fixed; left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); z-index: 60;
          display: grid; grid-template-columns: 1.15fr 1fr; gap: 8px;
          padding: 8px; border-radius: 22px;
          background: rgba(13, 15, 46, 0.82);
          backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
          border: 1px solid rgba(255, 255, 255, 0.12);
          box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
          transform: translateY(calc(100% + 30px));
          transition: transform 0.45s var(--ease-out);
        }
        .dock.show { transform: none; }
        .dock .btn { min-height: 52px; padding: 0 14px; font-size: 1rem; border-radius: 15px; }
        .dock .btn:hover { transform: none; box-shadow: none; }
        body.menu-open .dock { transform: translateY(calc(100% + 30px)); }
      }
    </style>
  </body>
</html>
