---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { business, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
}
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${business.url}/#business`,
  name: business.name,
  url: business.url,
  telephone: `+1-${business.phone}`,
  description,
  image: `${business.url}/assets/dove/welcome.webp`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.locations[0].street,
    addressLocality: business.locations[0].city,
    addressRegion: business.locations[0].region,
    postalCode: business.locations[0].zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: ['West Point, MS', 'Columbus, MS', 'Starkville, MS', 'Aberdeen, MS', 'Clay County, MS'].map((name) => ({ '@type': 'Place', name })),
  employee: { '@type': 'Person', name: business.director, jobTitle: 'Director' },
  department: [
    {
      '@type': 'LocalBusiness',
      name: `${business.name} Adult Day Services`,
      telephone: `+1-${business.phone}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.locations[1].street,
        addressLocality: business.locations[1].city,
        addressRegion: business.locations[1].region,
        addressCountry: 'US',
      },
    },
  ],
};
const phoneIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1Z"/></svg>';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#151842" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${business.url}/assets/dove/welcome.webp`} />
    <meta name="robots" content="noindex" /> {/* prototype: remove at launch */}
    <link rel="preload" as="image" href="/assets/dove/welcome.webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Heavenly Angels home">
          <img src="/assets/dove/guide.webp" alt="" width="48" height="43" />
          <span>Heavenly Angels</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
          <span class="sr-only">Menu</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
        <a class="btn btn-white header-call" href={business.phoneHref}>
          <Fragment set:html={phoneIcon} />
          <span>{business.phone}</span>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Heavenly Angels home">
            <img src="/assets/dove/guide.webp" alt="" width="48" height="43" loading="lazy" />
            <span>Heavenly Angels</span>
          </a>
          <p>Supervised living and adult day services for adults with disabilities in West Point, Mississippi.</p>
        </div>
        {business.locations.map((loc) => (
          <div>
            <h2 class="footer-h">{loc.label}</h2>
            <address>
              {loc.street}<br />{loc.city}, {loc.region} {loc.zip}
            </address>
            <a class="footer-link" href={loc.maps} rel="noopener" target="_blank">Get directions</a>
          </div>
        ))}
        <div>
          <h2 class="footer-h">Talk to us</h2>
          <a class="footer-phone" href={business.phoneHref}>{business.phone}</a>
          <p class="footer-small">Staff on site 24 hours a day, 7 days a week.</p>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} Heavenly Angels LLC · West Point, MS</span>
        <a href="/privacy/">Privacy</a>
      </div>
    </footer>

    <a class="call-bar" href={business.phoneHref}>
      <Fragment set:html={phoneIcon} />
      Call {business.phone}
    </a>

    <style is:global>
      .skip {
        position: absolute; left: 16px; top: -60px; z-index: 100;
        background: var(--gold); color: var(--ink); padding: 12px 18px; border-radius: 10px;
        font-weight: 700; text-decoration: none;
      }
      .skip:focus { top: 16px; }

      .site-header {
        position: fixed; inset: 0 0 auto; z-index: 50;
        padding-block: 12px;
        transition: background-color 0.3s, backdrop-filter 0.3s;
      }
      .site-header.scrolled {
        background: rgba(13, 15, 46, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }
      .header-inner { display: flex; align-items: center; gap: 24px; }
      .brand {
        display: inline-flex; align-items: center; gap: 10px;
        text-decoration: none; color: #fff;
        font: 800 1.25rem/1 var(--font-display); text-transform: uppercase; letter-spacing: -0.01em;
      }
      .brand img { width: 44px; height: auto; transition: transform 0.4s var(--ease-spring); }
      .brand:hover img { transform: rotate(-10deg) scale(1.08); }
      .site-nav { margin-left: auto; }
      .site-nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
      .site-nav a {
        display: block; padding: 10px 14px; border-radius: 999px;
        color: #fff; text-decoration: none; font-weight: 600; font-size: 1rem; white-space: nowrap;
        transition: background-color 0.2s;
      }
      .site-nav a:hover { background: rgba(255, 255, 255, 0.1); }
      .header-call { min-height: 46px; padding: 0 18px; font-size: 1rem; white-space: nowrap; flex: none; }
      .brand { white-space: nowrap; flex: none; }

      .site-footer { background: var(--twilight-deep); padding: 80px 0 120px; color: var(--mist); }
      .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
      .footer-brand p { margin-top: 18px; max-width: 30ch; }
      .footer-h {
        font: 700 0.82rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase;
        color: #fff; margin-bottom: 14px;
      }
      .site-footer address { font-style: normal; margin-bottom: 10px; }
      .footer-link { color: var(--gold); font-weight: 600; }
      .footer-phone { font: 800 1.35rem/1 var(--font-display); color: #fff; text-decoration: none; }
      .footer-small { margin-top: 10px; font-size: 0.95rem; }
      .footer-base {
        display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
        margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.92rem;
      }

      .call-bar { display: none; }
      .menu-btn { display: none; }

      @media (max-width: 1080px) {
        .menu-btn {
          display: grid; place-items: center; order: 3;
          width: 48px; height: 48px; border-radius: 14px; border: 0; cursor: pointer;
          background: rgba(255, 255, 255, 0.12); color: #fff;
        }
        .menu-lines, .menu-lines::before, .menu-lines::after {
          display: block; width: 20px; height: 2px; border-radius: 2px; background: currentColor;
          transition: transform 0.3s var(--ease-out), opacity 0.2s;
        }
        .menu-lines { position: relative; }
        .menu-lines::before, .menu-lines::after { content: ''; position: absolute; left: 0; }
        .menu-lines::before { top: -6px; }
        .menu-lines::after { top: 6px; }
        [aria-expanded='true'] .menu-lines { background: transparent; }
        [aria-expanded='true'] .menu-lines::before { transform: translateY(6px) rotate(45deg); }
        [aria-expanded='true'] .menu-lines::after { transform: translateY(-6px) rotate(-45deg); }
        .site-nav {
          position: absolute; top: calc(100% + 6px); left: var(--gutter); right: var(--gutter);
          margin: 0; padding: 10px; border-radius: 20px;
          background: var(--twilight-deep); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
          opacity: 0; visibility: hidden; transform: translateY(-8px);
          transition: opacity 0.25s, transform 0.25s var(--ease-out), visibility 0.25s;
        }
        .site-nav.open { opacity: 1; visibility: visible; transform: none; }
        .site-nav ul { flex-direction: column; }
        .site-nav a { padding: 14px 16px; font-size: 1.1rem; border-radius: 12px; }
        .header-call { margin-left: auto; }
        .footer-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 640px) {
        .header-call { display: none; }
        .menu-btn { margin-left: auto; }
        .footer-grid { grid-template-columns: 1fr; }
        .call-bar {
          position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 60;
          display: flex; align-items: center; justify-content: center; gap: 10px;
          min-height: 56px; border-radius: 16px;
          background: var(--gold); color: var(--ink); font-weight: 800; text-decoration: none;
          box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
        }
        .call-bar svg { width: 20px; }
      }
    </style>
  </body>
</html>
