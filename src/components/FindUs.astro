---
// Map + business info. Location cards switch the embedded map between the two addresses.
import { business } from '../data/site';

const pin = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>';
const phone = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1Z"/></svg>';
const mail = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v.4l8 5.1 8-5.1V7H4Zm16 2.8-7.5 4.8a1 1 0 0 1-1 0L4 9.8V17h16V9.8Z"/></svg>';
---
<section class="find" id="find-us" aria-labelledby="find-title">
  <div class="wrap">
    <div class="find-panel reveal">
      <div class="find-info">
        <p class="eyebrow">Find us</p>
        <h2 id="find-title">Two places in West Point</h2>

        <div class="find-locations" role="group" aria-label="Show on map">
          {business.locations.map((loc, i) => (
            <div class={`find-loc${i === 0 ? ' active' : ''}`} data-loc={i}>
              <button type="button" class="find-loc-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-embed={loc.embed} data-label={loc.label}>
                <span class="find-loc-pin"><Fragment set:html={pin} /></span>
                <span class="find-loc-text">
                  <strong>{loc.label}</strong>
                  <span>{loc.street}, {loc.city}, {loc.region} {loc.zip}</span>
                  <em>{loc.note}</em>
                </span>
              </button>
              <a class="find-dir" href={loc.maps} target="_blank" rel="noopener">Directions<span class="sr-only"> to {loc.label}</span> →</a>
            </div>
          ))}
        </div>

        <ul class="find-contact">
          <li><span class="find-ic"><Fragment set:html={phone} /></span><a href={business.phoneHref}>{business.phone}</a></li>
          <li><span class="find-ic"><Fragment set:html={mail} /></span><a href={`mailto:${business.email}`}>{business.email}</a></li>
        </ul>
        <p class="find-serve">Welcoming families from West Point, Columbus, Starkville, Aberdeen, and across the Golden Triangle.</p>
      </div>

      <div class="find-map">
        <iframe
          data-map
          src={business.locations[0].embed}
          title={`Map of ${business.locations[0].label}, ${business.locations[0].street}, West Point, MS`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const map = document.querySelector<HTMLIFrameElement>('[data-map]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.find-loc-btn')];
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!map || btn.getAttribute('aria-pressed') === 'true') return;
      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.closest('.find-loc')?.classList.toggle('active', on);
      });
      map.src = btn.dataset.embed ?? map.src;
      map.title = `Map of ${btn.dataset.label}, West Point, MS`;
    });
  });
</script>

<style>
  .find { padding: 40px 0 140px; background: var(--twilight-deep); }
  .find-panel {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 4vw, 48px);
    padding: clamp(20px, 3vw, 28px);
    border-radius: var(--r-panel);
    background: var(--cream);
    color: var(--ink-soft);
  }
  .find-info { padding: clamp(12px, 2.4vw, 28px); }
  .find-info .eyebrow { color: var(--dusk); }
  .find-info h2 { color: var(--ink); font-size: clamp(1.9rem, 3.4vw, 2.8rem); }

  .find-locations { display: grid; gap: 12px; margin: 26px 0 24px; }
  .find-loc {
    position: relative; border-radius: 20px; background: #fff;
    border: 2px solid #ebe7f5;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .find-loc.active { border-color: var(--indigo); box-shadow: 0 16px 30px -18px rgba(75, 82, 201, 0.6); }
  .find-loc-btn {
    display: flex; gap: 14px; align-items: flex-start; width: 100%;
    padding: 18px 18px 14px; border: 0; background: none; text-align: left; cursor: pointer;
    font: inherit; color: inherit; border-radius: 18px;
  }
  .find-loc-pin {
    display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 12px;
    background: #eef0ff; color: var(--indigo);
    transition: background-color 0.25s, color 0.25s;
  }
  .find-loc.active .find-loc-pin { background: var(--indigo); color: #fff; }
  .find-loc-pin :global(svg) { width: 22px; }
  .find-loc-text { display: grid; gap: 2px; }
  .find-loc-text strong { color: var(--ink); font-size: 1.06rem; }
  .find-loc-text span { font-size: 1rem; }
  .find-loc-text em { font-style: normal; font-size: 0.875rem; font-weight: 600; color: #1f7a4a; margin-top: 4px; }
  .find-dir {
    display: inline-block; margin: 0 0 14px 74px;
    font-weight: 700; color: var(--indigo); text-decoration: none;
  }
  .find-dir:hover { text-decoration: underline; }

  .find-contact { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 10px; }
  .find-contact li { display: flex; align-items: center; gap: 12px; }
  .find-contact a { color: var(--ink); font-weight: 700; text-decoration: none; word-break: break-word; }
  .find-contact a:hover { color: var(--indigo); }
  .find-ic { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 10px; background: var(--ink); color: var(--gold); }
  .find-ic :global(svg) { width: 18px; }
  .find-serve { margin: 0; font-size: 0.95rem; }

  .find-map {
    position: relative; min-height: 480px; border-radius: 24px; overflow: hidden;
    background: #dfe6f2;
    box-shadow: inset 0 0 0 1px rgba(21, 24, 66, 0.08);
  }
  .find-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  @media (max-width: 960px) {
    .find-panel { grid-template-columns: 1fr; }
    .find-map { min-height: 380px; }
  }
  @media (max-width: 640px) {
    .find { padding: 20px 0 90px; }
    .find-panel { padding: 14px; border-radius: 26px; }
    .find-info { padding: 14px 8px 4px; }
    .find-loc-btn { padding: 16px 14px 12px; }
    .find-dir { margin-left: 70px; }
    .find-map { min-height: 320px; border-radius: 18px; }
  }
</style>
